// RWAXI — multi-tenant data model (14 entities).
//
// Tenant = Organization (a real-estate developer). Every tenant-owned table carries
// `organization_id` and is protected by PostgreSQL Row-Level Security
// (see migrations/*_row_level_security and *_audit_events). The app connects with a
// non-superuser role and sets `app.current_organization_id` per transaction
// (src/client.ts → forTenant() / withTenant()).
//
//  1 Organization          8 KycCase
//  2 User                  9 DataRoomDocument
//  3 Offering             10 DataRoomAccessGrant
//  4 TokenDeployment      11 Subscription
//  5 Investor             12 ChainTransaction
//  6 Lead                 13 FeeLedgerEntry
//  7 NdaAcceptance        14 AuditEvent (append-only)

generator client {
  provider      = "prisma-client-js"
  // native: the developer's machine; rhel-openssl-3.0.x: Vercel's serverless runtime (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────── enums

enum PortalStatus {
  ACTIVE
  REVIEW
  SUSPENDED
}

enum DomainStatus {
  NOT_CONFIGURED
  PENDING_DNS
  VERIFIED
}

enum ComplianceRegime {
  SAGRILAFT_PTEE
  SARLAFT
}

enum UserRole {
  SUPER_ADMIN // Dirección RWAXI (admin.rwaxirealestate.com)
  RWAXI_OPERATOR // operación técnica RWAXI: factory + mint
  TENANT_ADMIN // administrador del desarrollador (backoffice)
  COMPLIANCE_OFFICER // oficial de cumplimiento del desarrollador
  TENANT_ANALYST // lectura en backoffice
}

enum OfferingStage {
  PRESALE // Pre-venta
  STRUCTURING // En estructuración / construcción
  OPERATING // En operación / rentando
}

/// Lifecycle of the investment vehicle: compliance and issuer wallets are not required while STRUCTURING
enum ProjectStatus {
  STRUCTURING // En estructuración: wallets de cumplimiento y del emisor aún sin declarar
  ACTIVE // Captando
  FUNDED // Meta de captación alcanzada
}

enum LegalWrapperType {
  SAS_SPV // SPV Sociedad por Acciones Simplificada
  FIDUCIARY_TRUST // Patrimonio Autónomo / Encargo Fiduciario
  PARTICIPATION_ACCOUNTS // Cuentas en Participación
}

enum ChainNetwork {
  POLYGON
  BASE
  POLYGON_AMOY
  BASE_SEPOLIA
  HARDHAT
}

enum TokenStatus {
  NOT_DEPLOYED
  DEPLOYING
  DEPLOYED
  PAUSED
}

enum LeadSource {
  REFERRAL // referido por la vitrina www.rwaxirealestate.com (token HMAC verificado y de un solo uso)
  DIRECT // tráfico propio del desarrollador, o referido sin firma válida
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  REVOKED // approved, then revoked by the compliance officer (revokeInvestor queued); never shown with its reason
}

enum RiskProfile {
  CONSERVATIVE
  MODERATE
  DYNAMIC
}

enum SubscriptionStatus {
  RESERVED // reserva sin token emitido (pre-venta): sin pago, mint ni comisión
  PAYMENT_PENDING // contrato firmado, unidades reservadas; espera la conciliación del pago fiduciario
  MINT_PENDING // pago confirmado por el desarrollador: mintSubscription() en cola (ChainTransaction PENDING)
  MINTED // mint confirmado: tokens en la wallet del inversionista
  CANCELLED
}

enum ChainExecutionMode {
  RPC // enviada y confirmada contra un nodo
  SIMULATION // firmada con OPERATOR_PRIVATE_KEY de forma determinista, sin difundir
}

enum ChainTxKind {
  TENANT_REGISTRY_DEPLOYED
  OFFERING_TOKEN_DEPLOYED
  INVESTOR_WHITELISTED
  INVESTOR_REVOKED
  INVESTOR_FREEZE_UPDATED
  SUBSCRIPTION_MINTED
  DATA_ROOM_ROOT_ANCHORED
  DISTRIBUTION_ROOT_ANCHORED
  FORCED_RECOVERY
  TOKEN_PAUSED
  TOKEN_UNPAUSED
  MINTER_ROLE_GRANTED // grantRole(MINTER_ROLE, issuer's own wallet): the issuer signs its own mints
}

enum ChainTxStatus {
  PENDING
  CONFIRMED
  REVERTED
  CANCELLED // withdrawn before it was ever sent (e.g. the approveInvestor or the mint of a revoked investor)
}

enum FeeKind {
  ONBOARDING_SETUP // Setup / Onboarding White Label
  MONTHLY_SAAS // Suscripción SaaS mensual
  INFRASTRUCTURE_USAGE // Uso de infraestructura · % del capital de cada operación de emisión
}

enum FeeStatus {
  ACCRUED
  INVOICED
  PAID
  VOIDED // accrued for an emission that never happened (subscription cancelled before its mint): never billed
}

enum AuditAction {
  KYC_APPROVED
  KYC_REJECTED
  SUBSCRIPTION_CREATED
  PAYMENT_CONFIRMED
  CHAIN_TX_CONFIRMED
  SUBSCRIPTION_MINTED
  // platform governance and B2B billing (admin.rwaxirealestate.com)
  PORTAL_STATUS_CHANGED
  ORGANIZATION_PUBLICATION_CHANGED
  OFFERING_CAPTURE_PAUSED
  OFFERING_CAPTURE_RESUMED
  FEE_TERMS_UPDATED
  FEE_INVOICED
  FEE_PAYMENT_RECORDED
  ORGANIZATION_ONBOARDED
  // yield distributions (backoffice)
  DISTRIBUTION_DECLARED
  // staff authentication (backoffice: the tenant's events; console: organization-less events)
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  MFA_FAILED
  MFA_ENROLLED
  ACCOUNT_LOCKED
  LOGOUT
  // investor portal
  INVESTOR_SESSION_RECOVERED
  INVESTOR_OTP_FAILED
  // staff accounts of onboarded developers: invitation from the console, activation on the tenant host
  STAFF_INVITED
  STAFF_INVITATION_RESENT
  ACCOUNT_ACTIVATED
  // document vault: verified uploads and audited access
  DATA_ROOM_DOCUMENT_ADDED
  DATA_ROOM_DOCUMENT_DOWNLOADED
  KYC_DOCUMENT_VIEWED
  VAULT_INTEGRITY_FAILED
  // compliance after approval (backoffice) and the issuer's own minting
  KYC_REVOKED
  SUBSCRIPTION_CANCELLED
  INVESTOR_FREEZE_REQUESTED
  MINTER_ROLE_REQUESTED
}

enum SessionScope {
  TENANT // developer backoffice ({slug}.rwaxirealestate.com), bound to one organization
  PLATFORM // RWAXI console (admin.rwaxirealestate.com), organization-less staff
}

enum DistributionStatus {
  DECLARED // allocations committed (Merkle root computed); anchorDistributionRoot() queued
  ANCHORED // root confirmed on the token (RwaxiPropertyToken.distributionRoots)
}

/// Delivery of a mail_outbox row (MailDispatcher).
enum MailStatus {
  PENDING // queued: the body is in the row until it is delivered
  SENT // accepted by the mail provider: body redacted
  CAPTURED // delivered to the development sink (server log): readable until what it carries is used or expires
  FAILED // refused by the provider on every attempt: body redacted
  CANCELLED // what it carried stopped being valid before it was delivered: body redacted
}

/// Why a mail_outbox body (an OTP code, an activation link) was cleared; delivery metadata stays.
enum MailRedaction {
  SENT // the provider holds the copy
  FAILED // undeliverable
  CONSUMED // the code or link it carried was used
  SUPERSEDED // a newer code or link replaced it
  EXPIRED // what it carried expired
}

// ─────────────────────────────────────────────────────────────── 1. tenant

model Organization {
  id                     String           @id @default(cuid())
  slug                   String           @unique // {slug}.rwaxirealestate.com
  displayName            String           @map("display_name")
  legalName              String           @map("legal_name")
  taxId                  String           @unique @map("tax_id") // NIT
  brandColor             String           @map("brand_color") // #RRGGBB
  logoUrl                String?          @map("logo_url")
  customDomain           String?          @unique @map("custom_domain")
  domainStatus           DomainStatus     @default(NOT_CONFIGURED) @map("domain_status")
  complianceRegime       ComplianceRegime @map("compliance_regime")
  complianceContactEmail String           @map("compliance_contact_email")
  portalStatus           PortalStatus     @default(REVIEW) @map("portal_status")
  published              Boolean          @default(false)
  ndaTemplate            String           @map("nda_template")
  complianceTemplate     Json             @map("compliance_template")
  /// keccak256(id) — organizationId in RwaxiTenantFactory
  onchainId              String?          @unique @map("onchain_id")
  complianceRegistry     String?          @map("compliance_registry_address")
  feeSetupUsd            Decimal          @default(0) @map("fee_setup_usd") @db.Decimal(18, 2)
  feeMonthlyUsd          Decimal          @default(0) @map("fee_monthly_usd") @db.Decimal(18, 2)
  feeUsagePct            Decimal          @default(0) @map("fee_usage_pct") @db.Decimal(6, 3)
  onboardedAt            DateTime         @default(now()) @map("onboarded_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  users          User[]
  offerings      Offering[]
  tokens         TokenDeployment[]
  investors      Investor[]
  leads          Lead[]
  ndaAcceptances NdaAcceptance[]
  kycCases       KycCase[]
  documents      DataRoomDocument[]
  accessGrants   DataRoomAccessGrant[]
  subscriptions  Subscription[]
  chainTxs       ChainTransaction[]
  feeEntries     FeeLedgerEntry[]
  feeInvoices    FeeInvoice[]
  distributions  Distribution[]
  allocations    DistributionAllocation[]
  auditEvents    AuditEvent[]
  userSessions   UserSession[]
  investorOtps   InvestorOtp[]
  mailOutbox     MailOutbox[]
  invitations    UserInvitation[]
  vaultObjects   VaultObject[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────── 2. identity

model User {
  id                     String    @id @default(cuid())
  /// null for RWAXI staff (SUPER_ADMIN / RWAXI_OPERATOR)
  organizationId         String?   @map("organization_id")
  email                  String    @unique
  fullName               String    @map("full_name")
  role                   UserRole
  walletAddress          String?   @map("wallet_address")
  active                 Boolean   @default(true)
  /// scrypt hash `scrypt$N$r$p$salt$hash` (credentials.ts); null until the account has a password
  passwordHash           String?   @map("password_hash")
  /// TOTP secret (RFC 6238) sealed with AES-256-GCM (AUTH_ENCRYPTION_KEY), bound to this user's id
  totpSecretEnc          String?   @map("totp_secret_enc")
  /// MFA enrolment confirmed with a valid code; until then the next login enrols a new secret
  mfaEnrolledAt          DateTime? @map("mfa_enrolled_at")
  /// last accepted TOTP time step: a code is never accepted twice
  totpLastStep           Int?      @map("totp_last_step")
  /// consecutive failed password or TOTP attempts; enough of them lock the account for a while
  failedLoginCount       Int       @default(0) @map("failed_login_count")
  lockedUntil            DateTime? @map("locked_until")
  lastLoginAt            DateTime? @map("last_login_at")
  /// platform legal wall: acceptance of RWAXI's liability terms (technology provider, never the issuer)
  acceptedRwaxiLiability Boolean   @default(false) @map("accepted_rwaxi_liability")
  rwaxiAcceptanceDate    DateTime? @map("rwaxi_acceptance_date")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization          Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions              UserSession[]
  invitations           UserInvitation[]
  reviewedCases         KycCase[]        @relation("KycReviewer")
  revokedCases          KycCase[]        @relation("KycRevoker")
  auditEvents           AuditEvent[]
  confirmedPayments     Subscription[]   @relation("SubscriptionPaymentConfirmer")
  declaredDistributions Distribution[]

  @@index([organizationId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────── 3–4. offering

model Offering {
  id                   String           @id @default(cuid())
  organizationId       String           @map("organization_id")
  code                 String // P-01
  assetName            String           @map("asset_name")
  city                 String
  region               String
  assetType            String           @map("asset_type")
  stage                OfferingStage
  status               ProjectStatus    @default(STRUCTURING)
  renderKind           String           @map("render_kind") // tower | suites | resort
  legalEntityName      String           @map("legal_entity_name")
  legalWrapperType     LegalWrapperType @map("legal_wrapper_type")
  legalWrapperNote     String           @map("legal_wrapper_note")
  economicRight        String           @map("economic_right")
  targetIrrPct         Decimal          @map("target_irr_pct") @db.Decimal(6, 2)
  distributionYieldPct Decimal          @map("distribution_yield_pct") @db.Decimal(6, 2)
  appreciationPct      Decimal          @map("appreciation_pct") @db.Decimal(6, 2)
  minTicketUsd         Decimal          @map("min_ticket_usd") @db.Decimal(18, 2)
  unitPriceUsd         Decimal          @map("unit_price_usd") @db.Decimal(18, 2)
  raiseTargetUsd       Decimal          @map("raise_target_usd") @db.Decimal(18, 2)
  assetValueUsd        Decimal          @map("asset_value_usd") @db.Decimal(18, 2)
  totalUnits           Int              @map("total_units")
  /// units already committed (subscriptions + historic placements); CHECK 0 ≤ units_subscribed ≤ total_units
  unitsSubscribed      Int              @default(0) @map("units_subscribed")
  rentStartMonths      Int              @map("rent_start_months")
  network              ChainNetwork
  /// [legal, financiero, tecnologia, capital] → done | active | pending
  pipeline             Json
  videoConfig          Json?            @map("video_config")
  /// current Data Room Merkle root (bytes32 hex) — see @rwaxi/blockchain-sdk/merkle
  dataRoomRoot         String?          @map("data_room_root")
  /// the developer's commercial copy in other languages: { locale: { city, region, assetType, economicRight,
  /// legalWrapperNote } }; the columns above are the Spanish original and the fallback
  translations         Json             @default("{}")
  published            Boolean          @default(false)
  /// platform (off-chain) pause of capital raising: no new subscriptions while set; never touches the token
  capturePausedAt      DateTime?        @map("capture_paused_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token         TokenDeployment?
  leads         Lead[]
  ndas          NdaAcceptance[]
  kycCases      KycCase[]
  documents     DataRoomDocument[]
  accessGrants  DataRoomAccessGrant[]
  subscriptions Subscription[]
  chainTxs      ChainTransaction[]
  distributions Distribution[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("offerings")
}

model TokenDeployment {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  offeringId      String       @unique @map("offering_id")
  network         ChainNetwork
  name            String
  symbol          String
  maxSupply       Int          @map("max_supply")
  unitPriceUsd    Decimal      @map("unit_price_usd") @db.Decimal(18, 2)
  /// keccak256(offering.id) — offeringId in RwaxiTenantFactory
  onchainId       String?      @unique @map("onchain_id")
  contractAddress String?      @map("contract_address")
  deployTxHash    String?      @map("deploy_tx_hash")
  status          TokenStatus  @default(NOT_DEPLOYED)
  deployedAt      DateTime?    @map("deployed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offering     Offering     @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("token_deployments")
}

// ─────────────────────────────────────────────────────────────── 5–8. investor funnel

/// Created when the visitor signs the NDA (name + email); identity document and wallet
/// arrive with the KYC submission, hence optional.
model Investor {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  fullName          String    @map("full_name")
  email             String?
  docType           String?   @map("doc_type") // CC | CE | PA | NIT
  docNumber         String?   @map("doc_number")
  countryCode       Int       @default(170) @map("country_code") // ISO 3166-1 numérico
  /// EVM wallet declared in the KYC wizard; whitelisted on approval
  walletAddress     String?   @map("wallet_address")
  /// tenant legal wall: the developer's NDA (the tenant's own, binding document), accepted in its portal
  tenantNdaAccepted Boolean   @default(false) @map("tenant_nda_accepted")
  tenantNdaDate     DateTime? @map("tenant_nda_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads         Lead[]
  ndas          NdaAcceptance[]
  kycCases      KycCase[]
  accessGrants  DataRoomAccessGrant[]
  subscriptions Subscription[]
  allocations   DistributionAllocation[]
  otps          InvestorOtp[]

  @@unique([organizationId, docType, docNumber])
  @@unique([organizationId, email])
  @@unique([organizationId, walletAddress])
  @@index([organizationId])
  @@map("investors")
}

/// Referral attribution: a visitor arriving from the RWAXI vitrina carries `referral_token`.
model Lead {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  offeringId     String     @map("offering_id")
  investorId     String?    @map("investor_id")
  referralToken  String     @unique @map("referral_token") // ref_rwx_…
  source         LeadSource
  landedAt       DateTime   @default(now()) @map("landed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offering     Offering     @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  investor     Investor?    @relation(fields: [investorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([offeringId])
  @@map("leads")
}

/// ConsentRecord of the signed NDA (hash of the filled legal text + signer data).
model NdaAcceptance {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  offeringId     String   @map("offering_id")
  investorId     String   @map("investor_id")
  signerName     String   @map("signer_name")
  signerEmail    String   @map("signer_email")
  documentHash   String   @map("document_hash") // SHA-256
  ipAddress      String?  @map("ip_address")
  acceptedAt     DateTime @default(now()) @map("accepted_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offering     Offering              @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  investor     Investor              @relation(fields: [investorId], references: [id], onDelete: Cascade)
  accessGrants DataRoomAccessGrant[]

  @@unique([offeringId, investorId])
  @@index([organizationId])
  @@map("nda_acceptances")
}

model KycCase {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  investorId       String       @map("investor_id")
  offeringId       String?      @map("offering_id")
  status           KycStatus    @default(NOT_STARTED)
  activity         String?
  incomeBracket    Int?         @map("income_bracket")
  riskProfile      RiskProfile? @map("risk_profile")
  isPep            Boolean      @default(false) @map("is_pep")
  listsResult      String?      @map("lists_result") // listas restrictivas (OFAC, ONU, …)
  /// SHA-256 of the KYC dossier + NDA — written on-chain as kycDossierHash
  dossierHash      String?      @map("dossier_hash")
  /// Canonical dossier the server hashed into dossierHash (form, document SHA-256s, consents);
  /// sha256(JSON.stringify(evidence)) must equal dossierHash. Files themselves are not stored here.
  evidence         Json?
  rejectionReason  String?      @map("rejection_reason")
  reviewedById     String?      @map("reviewed_by_id")
  reviewedAt       DateTime?    @map("reviewed_at")
  whitelistTxHash  String?      @map("whitelist_tx_hash")
  /// revocation of an approved case (REVOKED): never shown to the investor (no tipping-off under SAGRILAFT/SARLAFT)
  revokedAt        DateTime?    @map("revoked_at")
  revokedById      String?      @map("revoked_by_id")
  /// closed list (REVOCATION_REASONS, Spanish source text)
  revocationReason String?      @map("revocation_reason")
  /// the compliance officer's justification (10–300 characters)
  revocationNote   String?      @map("revocation_note")
  submittedAt      DateTime?    @map("submitted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  investor     Investor              @relation(fields: [investorId], references: [id], onDelete: Cascade)
  offering     Offering?             @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  reviewedBy   User?                 @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  revokedBy    User?                 @relation("KycRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  accessGrants DataRoomAccessGrant[]

  @@index([organizationId, status])
  @@map("kyc_cases")
}

// ─────────────────────────────────────────────────────────────── 9–10. data room

model DataRoomDocument {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  offeringId     String   @map("offering_id")
  folder         String // "01 Jurídico y Tradición"
  name           String
  restricted     Boolean  @default(true) // requires NDA + KYC grant
  sha256         String // Merkle leaf
  sizeBytes      Int      @map("size_bytes")
  storageKey     String?  @map("storage_key")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offering     Offering     @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, sha256])
  @@index([organizationId])
  @@map("data_room_documents")
}

/// Time-boxed access to restricted documents, issued once NDA is signed and KYC is approved.
model DataRoomAccessGrant {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  offeringId      String    @map("offering_id")
  investorId      String    @map("investor_id")
  ndaAcceptanceId String    @map("nda_acceptance_id")
  kycCaseId       String    @map("kyc_case_id")
  grantedAt       DateTime  @default(now()) @map("granted_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offering      Offering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  investor      Investor      @relation(fields: [investorId], references: [id], onDelete: Cascade)
  ndaAcceptance NdaAcceptance @relation(fields: [ndaAcceptanceId], references: [id], onDelete: Cascade)
  kycCase       KycCase       @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([investorId, offeringId])
  @@map("data_room_access_grants")
}

// ─────────────────────────────────────────────────────────────── 11–12. capital & chain

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @map("organization_id")
  offeringId           String             @map("offering_id")
  investorId           String             @map("investor_id")
  /// keccak256(id) — idempotency key for mintSubscription()
  onchainId            String?            @unique @map("onchain_id")
  units                Int
  capitalUsd           Decimal            @map("capital_usd") @db.Decimal(18, 2)
  status               SubscriptionStatus @default(RESERVED)
  /// SHA-256 of the signed subscription agreement (canonical JSON kept in the AuditEvent)
  agreementHash        String?            @map("agreement_hash")
  /// bank / fiduciary receipt reference entered by the developer when reconciling the payment
  paymentReference     String?            @map("payment_reference")
  paymentConfirmedAt   DateTime?          @map("payment_confirmed_at")
  paymentConfirmedById String?            @map("payment_confirmed_by_id")
  /// evidenceHash({subscriptionId, agreementHash, paymentReference}) — mintSubscription(paymentEvidenceRef)
  paymentEvidenceRef   String?            @map("payment_evidence_ref")
  mintTxHash           String?            @map("mint_tx_hash")
  /// set exactly when CANCELLED (CHECK); a cancelled subscription released its committed units
  cancelledAt          DateTime?          @map("cancelled_at")
  /// e.g. KYC_REVOKED
  cancellationReason   String?            @map("cancellation_reason")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offering           Offering         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  investor           Investor         @relation(fields: [investorId], references: [id], onDelete: Cascade)
  paymentConfirmedBy User?            @relation("SubscriptionPaymentConfirmer", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  feeEntries         FeeLedgerEntry[]

  /// one fiduciary receipt reconciles one subscription
  @@unique([organizationId, paymentReference])
  @@index([organizationId, status])
  @@map("subscriptions")
}

/// Append-only ledger of on-chain operations (what the On-Chain Inspector shows).
model ChainTransaction {
  id                String              @id @default(cuid())
  organizationId    String              @map("organization_id")
  offeringId        String?             @map("offering_id")
  network           ChainNetwork
  kind              ChainTxKind
  contractAddress   String              @map("contract_address")
  method            String // e.g. mintSubscription(bytes32,address,uint256,bytes32)
  args              Json
  txHash            String?             @unique @map("tx_hash")
  blockNumber       BigInt?             @map("block_number")
  status            ChainTxStatus       @default(PENDING)
  error             String?
  /// how it was confirmed; SIMULATION = signed deterministically, never broadcast
  executionMode     ChainExecutionMode? @map("execution_mode")
  signerAddress     String?             @map("signer_address")
  nonce             Int?
  /// raw EIP-1559 signed transaction (SIMULATION); txHash = keccak256(signedTransaction)
  signedTransaction String?             @map("signed_transaction")
  executedAt        DateTime?           @map("executed_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offering     Offering?    @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  /// one nonce per signer, network and mode (simulated nonces never share the real chain's sequence)
  @@unique([network, executionMode, signerAddress, nonce], map: "chain_transactions_signer_nonce_key")
  @@index([organizationId, createdAt])
  @@map("chain_transactions")
}

// ─────────────────────────────────────────────────────────────── 12b. yield distributions

/// A yield distribution of an offering, split pro rata over the MINTED token balances at the snapshot
/// and committed in a SHA-256 Merkle tree (@rwaxi/blockchain-sdk/distribution).
model Distribution {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  offeringId     String             @map("offering_id")
  /// keccak256("rwaxi.distribution:{offeringId}:{period}"): distributionId in RwaxiPropertyToken.anchorDistributionRoot
  onchainId      String             @unique @map("onchain_id")
  /// month (2026-09) or quarter (2026-Q3), unique per offering
  period         String
  /// declared amount and currency; COP is converted at fxRate (COP per USD)
  currency       String
  amountDeclared Decimal            @map("amount_declared") @db.Decimal(20, 2)
  fxRate         Decimal?           @map("fx_rate") @db.Decimal(12, 4)
  totalUsd       Decimal            @map("total_usd") @db.Decimal(18, 2)
  totalUnits     Int                @map("total_units")
  holders        Int
  snapshotAt     DateTime           @map("snapshot_at")
  merkleRoot     String             @map("merkle_root")
  status         DistributionStatus @default(DECLARED)
  anchorTxHash   String?            @map("anchor_tx_hash")
  declaredById   String?            @map("declared_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offering     Offering                 @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  declaredBy   User?                    @relation(fields: [declaredById], references: [id], onDelete: SetNull)
  allocations  DistributionAllocation[]

  @@unique([offeringId, period])
  @@index([organizationId, createdAt])
  @@map("distributions")
}

/// One holder's share of a distribution with its Merkle inclusion proof. Append-only.
model DistributionAllocation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  distributionId String   @map("distribution_id")
  investorId     String   @map("investor_id")
  wallet         String
  units          Int
  amountUsd      Decimal  @map("amount_usd") @db.Decimal(18, 2)
  leafHash       String   @map("leaf_hash")
  /// sibling hashes bottom-up (bytes32[])
  merkleProof    Json     @map("merkle_proof")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  distribution Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  investor     Investor     @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([distributionId, investorId])
  @@index([organizationId])
  @@index([investorId])
  @@map("distribution_allocations")
}

// ─────────────────────────────────────────────────────────────── 13. RWAXI revenue

model FeeLedgerEntry {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  subscriptionId String?   @map("subscription_id")
  kind           FeeKind
  amountUsd      Decimal   @map("amount_usd") @db.Decimal(18, 2)
  /// capital base for USAGE fees
  baseUsd        Decimal?  @map("base_usd") @db.Decimal(18, 2)
  period         String? // YYYY-MM for SAAS
  accruedOn      DateTime  @map("accrued_on") @db.Date
  evidence       String // contract ref or tx hash
  status         FeeStatus @default(ACCRUED)
  /// RWAXI invoice that billed it: set exactly when status is INVOICED or PAID (CHECK)
  invoiceId      String?   @map("invoice_id")
  /// set exactly when VOIDED (CHECK): its subscription was cancelled before the mint
  voidedAt       DateTime? @map("voided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice      FeeInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([invoiceId])
  @@map("fee_ledger_entries")
}

/// RWAXI B2B invoice to a developer: groups ACCRUED ledger entries of one organization.
/// Issued → its entries are INVOICED; payment recorded (date + receipt) → they are PAID.
model FeeInvoice {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  /// RWAXI invoice number, unique across the platform
  number         String    @unique
  issuedAt       DateTime  @map("issued_at")
  totalUsd       Decimal   @map("total_usd") @db.Decimal(18, 2)
  /// payment date stated on the receipt; set together with paymentReceipt (CHECK)
  paidOn         DateTime? @map("paid_on") @db.Date
  paymentReceipt String?   @map("payment_receipt")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FeeLedgerEntry[]

  @@index([organizationId])
  @@map("fee_invoices")
}

// ─────────────────────────────────────────────────────────────── 14. audit trail

/// Append-only record of compliance decisions. The app roles may only SELECT and INSERT
/// (no UPDATE/DELETE policies, privileges revoked) — see migrations/*_audit_events.
model AuditEvent {
  id             String      @id @default(cuid())
  /// null only for organization-less staff authentication (console logins: CHECK audit_events_platform_auth)
  organizationId String?     @map("organization_id")
  action         AuditAction
  actorUserId    String?     @map("actor_user_id")
  /// denormalised so the trail survives the removal of the user
  actorEmail     String      @map("actor_email")
  entityType     String      @map("entity_type") // e.g. "KycCase"
  entityId       String      @map("entity_id")
  /// SHA-256 of the evidence behind the decision (KycCase.dossierHash for KYC events)
  subjectHash    String?     @map("subject_hash")
  /// snapshot at decision time: status transition, investor, reason, linked records
  payload        Json
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// ───────────────────────────────────────────────────────── Authentication

/// Authenticated staff session. The rwaxi_session cookie holds an opaque token; only its SHA-256 is stored.
/// It is usable once mfa_verified_at is set; until then it only allows the TOTP step, for a few minutes.
model UserSession {
  id             String       @id @default(cuid())
  /// null for PLATFORM sessions (CHECK); TENANT sessions are visible only under their tenant (RLS)
  organizationId String?      @map("organization_id")
  userId         String       @map("user_id")
  scope          SessionScope
  tokenHash      String       @unique @map("token_hash")
  mfaVerifiedAt  DateTime?    @map("mfa_verified_at")
  /// failed TOTP attempts while the session waits for its MFA step
  mfaAttempts    Int          @default(0) @map("mfa_attempts")
  expiresAt      DateTime     @map("expires_at")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  revokedAt      DateTime?    @map("revoked_at")
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("user_sessions")
}

/// One-time code an investor uses to recover the signed session of a portal on another browser or device.
/// Only its HMAC is stored; it expires after 10 minutes and allows a limited number of attempts.
model InvestorOtp {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  investorId     String    @map("investor_id")
  codeHash       String    @map("code_hash")
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  investor     Investor     @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId, createdAt])
  @@index([organizationId, createdAt])
  @@map("investor_otps")
}

/// Outgoing email, delivered by the MailDispatcher (@rwaxi/mail: Resend, Postmark or a webhook; in development the
/// server log). The body carries a secret (an OTP code, an activation link): it is cleared as soon as it is no
/// longer needed — sent, undeliverable, used, superseded or expired — keeping only what audits the delivery.
model MailOutbox {
  id                String         @id @default(cuid())
  organizationId    String?        @map("organization_id")
  /// INVESTOR_OTP | STAFF_INVITATION
  purpose           String
  toEmail           String         @map("to_email")
  subject           String
  /// the message as queued; NULL once redacted
  body              String?
  /// SHA-256 (hex) of the body as queued: what was sent stays provable after the body is gone
  bodySha256        String         @map("body_sha256")
  status            MailStatus     @default(PENDING)
  /// INVESTOR_OTP → investor_otps.id · STAFF_INVITATION → user_invitations.id
  relatedId         String?        @map("related_id")
  /// when the code or link it carries stops working
  expiresAt         DateTime?      @map("expires_at")
  /// resend | postmark | webhook | dev
  provider          String?
  providerMessageId String?        @map("provider_message_id")
  attempts          Int            @default(0)
  lastAttemptAt     DateTime?      @map("last_attempt_at")
  lastError         String?        @map("last_error")
  createdAt         DateTime       @default(now()) @map("created_at")
  /// accepted by the provider (SENT) or written to the development sink (CAPTURED)
  sentAt            DateTime?      @map("sent_at")
  redactedAt        DateTime?      @map("redacted_at")
  redactionReason   MailRedaction? @map("redaction_reason")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([toEmail, createdAt])
  @@index([organizationId, createdAt])
  @@index([status, lastAttemptAt])
  @@index([relatedId])
  @@index([expiresAt])
  @@map("mail_outbox")
}

/// Hits of the platform's rate limits (e.g. DocumentVault uploads per session and per IP address). Not tenant
/// data — buckets are hashed addresses and session subjects — and never read by the app: only the SECURITY
/// DEFINER function rwaxi_rate_limit_hit() records and counts them.
model RateLimitHit {
  id     BigInt   @id @default(autoincrement())
  bucket String
  hitAt  DateTime @default(now()) @map("hit_at") @db.Timestamptz(3)

  @@index([bucket, hitAt])
  @@map("rate_limit_hits")
}

/// Activation of a staff account created by the B2B onboarding (no password yet): a single-use link sent by
/// email. Only the SHA-256 of its token is stored. Activating = password + TOTP enrolment, in two steps whose
/// first one parks its results here until the code confirms them.
model UserInvitation {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")
  userId               String    @map("user_id")
  tokenHash            String    @unique @map("token_hash")
  expiresAt            DateTime  @map("expires_at")
  /// password and MFA set: the account is active
  consumedAt           DateTime? @map("consumed_at")
  /// replaced by a newer invitation of the same user
  revokedAt            DateTime? @map("revoked_at")
  /// scrypt hash chosen in the first activation step, applied with the TOTP enrolment
  pendingPasswordHash  String?   @map("pending_password_hash")
  /// TOTP secret of that enrolment (AES-256-GCM, bound to the user id)
  pendingTotpSecretEnc String?   @map("pending_totp_secret_enc")
  createdAt            DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId])
  @@map("user_invitations")
}

/// A file of the DocumentVault (@rwaxi/document-vault): content-addressed by its SHA-256 and isolated per
/// tenant (storage key tenants/{organization}/sha256/{hex}). The server wrote it only after checking type, size
/// and hash, and re-hashes it on every download. Append-only for the app roles.
model VaultObject {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// 0x + SHA-256 of the bytes
  sha256         String
  sizeBytes      Int      @map("size_bytes")
  /// read from the bytes (magic numbers), not from what the browser declared
  mimeType       String   @map("mime_type")
  storageKey     String   @map("storage_key")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sha256])
  @@map("vault_objects")
}
