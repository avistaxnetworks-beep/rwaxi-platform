# --- Database (packages/database, apps/web) ---------------------------------
# App role: non-superuser, NO BYPASSRLS, subject to Row-Level Security.
# Neon: create it with `pnpm db:provision-app-role` and use the pooled host it prints
# (…-pooler.….neon.tech/neondb?sslmode=require&connect_timeout=15).
DATABASE_URL="postgresql://rwaxi_app:rwaxi_app@localhost:5432/rwaxi?schema=public"
# Platform role (BYPASSRLS): Super-Admin console only (admin.rwaxi.com).
PLATFORM_DATABASE_URL="postgresql://rwaxi_platform:rwaxi_platform@localhost:5432/rwaxi?schema=public"
# Owner role: used by Prisma Migrate and the seed (superusers bypass RLS).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rwaxi?schema=public"

# --- Multi-tenant routing (apps/web) -----------------------------------------
# Root domain the Edge Middleware strips to find the environment.
#   localhost:3000          -> vitrina       (www)
#   admin.localhost:3000    -> super-admin   (admin)
#   avista.localhost:3000   -> portal + /backoffice of tenant "avista"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
# Optional JSON map of verified custom domains -> tenant slug (overrides defaults).
# RWAXI_CUSTOM_DOMAINS='{"invest.avistaresort.co":"avista"}'

# --- Investor portal -----------------------------------------------------------
# HMAC key of the investor session cookie (rwaxi_inv), issued when the NDA is signed.
# >= 32 chars; required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INVESTOR_SESSION_SECRET=""

# --- Backoffice access ---------------------------------------------------------
# Demo session (acts as the tenant's compliance officer) until real auth exists.
# Default: on outside production, off in production. 1 = force on, 0 = force off.
# RWAXI_DEMO_AUTH="0"

# --- Blockchain (packages/blockchain-sdk, contracts) -------------------------
RPC_URL_POLYGON_AMOY=""
RPC_URL_BASE_SEPOLIA=""
RWAXI_FACTORY_ADDRESS=""
# Never commit real keys. Local Hardhat accounts only.
DEPLOYER_PRIVATE_KEY=""
