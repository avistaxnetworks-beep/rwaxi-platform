{
  "name": "rwaxi-platform",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @rwaxi/database db:generate",
    "db:migrate": "pnpm --filter @rwaxi/database db:migrate",
    "db:deploy": "pnpm --filter @rwaxi/database db:deploy",
    "db:seed": "pnpm --filter @rwaxi/database db:seed",
    "contracts:compile": "pnpm --filter @rwaxi/contracts compile",
    "contracts:test": "pnpm --filter @rwaxi/contracts test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  }
}
