{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_PLATFORM_DOMAIN", "NEXT_PUBLIC_ROOT_DOMAIN", "RWAXI_CUSTOM_DOMAINS", "DATABASE_URL", "PLATFORM_DATABASE_URL", "DIRECT_URL", "RWAXI_DEMO_AUTH", "RWAXI_INSPECTOR_SOURCE"],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "artifacts/**", "cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
